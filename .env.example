# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the real values.
# Everything prefixed NEXT_PUBLIC_ is inlined into the browser bundle, so never
# put a secret here. The reCAPTCHA SECRET key belongs in the Apps Script only.
# ---------------------------------------------------------------------------

# Deployed Google Apps Script web-app URL (must end in /exec)
NEXT_PUBLIC_LEAD_ENDPOINT=https://script.google.com/macros/s/AKfycbxxxxxxxxxxxxxxxxxxxxxx/exec

# Google reCAPTCHA v3 SITE key (public half of the pair)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6Lxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Production origin — used for metadataBase, Open Graph and JSON-LD
NEXT_PUBLIC_SITE_URL=https://majestictower.patilbuilders.in

# Optional: where the gated brochure download points once a lead is captured
NEXT_PUBLIC_BROCHURE_URL=/majestic-tower-brochure.pdf

# Google Tag Manager container ID. Defaults to GTM-54X3PCH8 if unset;
# set it to an empty value to omit the GTM tags entirely.
NEXT_PUBLIC_GTM_ID=GTM-54X3PCH8
